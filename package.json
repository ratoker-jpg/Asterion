{
  "name": "asterion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:combat": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/combat/priority.test.ts src/domain/combat/report.test.ts src/domain/combat/resolver.test.ts src/domain/combat/factions.test.ts src/domain/combat/technologies.test.ts src/domain/combat/technology-resolver.test.ts",
    "test:operations": "node --experimental-strip-types --test src/domain/operations/operations.test.ts",
    "test:command": "node --experimental-strip-types --test src/domain/command/command.test.ts",
    "test:reports": "node --experimental-strip-types --test src/domain/reports/reports.test.ts",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.asterion.game",
    "productName": "Asterion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
