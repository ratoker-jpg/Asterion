{
  "name": "asterion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "assets:asterion:generate": "node tools/asterion-asset-integration.mjs generate",
    "assets:asterion:rebaseline-pirate-ships": "node tools/asterion-asset-integration.mjs rebaseline-pirate-ships",
    "assets:asterion:audit": "node tools/asterion-asset-integration.mjs audit",
    "test:inventory": "node tools/check-test-inventory.mjs",
    "test:npc": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/npc/*.test.ts src/application/npc-*.test.ts src/application/state.test.ts",
    "benchmark:npc": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs tools/benchmark-npc.mjs",
    "benchmark:npc-replay": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs tools/benchmark-npc-replay.mjs",
    "benchmark:npc-full-world": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs tools/benchmark-npc-full-world.mjs",
    "test:buildings": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/buildings/balance-v1.test.ts src/domain/buildings/resource-zone.test.ts src/domain/buildings/production-bots.test.ts src/domain/buildings/production-bot-building-limits.test.ts src/domain/buildings/recycling.test.ts src/domain/buildings/recycling-building-limits.test.ts src/domain/buildings/trade.test.ts src/domain/buildings/spaceport-building-limits.test.ts src/domain/buildings/spaceport-upgrades.test.ts src/building-interior-navigation.test.ts",
    "test:application": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/application/application.test.ts src/application/ship-catalog-save-compatibility.test.ts src/application/offline-boundaries.test.ts src/application/science-refunds.test.ts src/application/building-refund-notice.test.ts",
    "test:flights": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/flights/*.test.ts src/application/flights.test.ts src/application/alliance-aid.test.ts src/application/commander-deployment.test.ts src/application/map-transport.test.ts src/application/flight-visibility.test.ts src/application/owner-presence.test.ts",
    "test:attack": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/application/attack.test.ts src/application/satellite-defense.test.ts",
    "test:pirate-operations": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/application/pirate-battle-export.test.ts src/application/pirates.test.ts src/application/pirate-persistence.integration.test.ts src/application/pirate-presentation.test.ts src/application/pirate-operations.integration.test.ts src/application/pirate-combat.integration.test.ts src/application/pirate-raids.integration.test.ts",
    "test:espionage": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/espionage/runtime.test.ts src/domain/espionage/orbital-debris.test.ts src/application/espionage.test.ts",
    "test:combat": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/combat/priority.test.ts src/domain/combat/report.test.ts src/domain/combat/battle-report-view-model.test.ts src/domain/combat/battle-points.test.ts src/domain/combat/resolver.test.ts src/domain/combat/destroyer-revival.test.ts src/domain/combat/planet-siege.test.ts src/domain/combat/combat-v2.test.ts src/domain/combat/combat-v3.test.ts src/domain/combat/factions.test.ts src/domain/combat/ship-catalog-parity.test.ts src/domain/combat/ship-art-parity.test.ts src/domain/combat/technologies.test.ts src/domain/combat/technology-resolver.test.ts src/domain/combat/controlled-sweep.test.ts src/ui/battle-report-faction-art.test.ts src/domain/combat/phantom-contract.test.ts",
    "test:pirates": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/pirates/*.test.ts",
    "balance:pirates": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs tools/generate-pirate-combat-balance.mjs",
    "balance:pirates:pr91": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs tools/generate-pirate-pr91-balance.mjs",
    "balance:pirates:pr91:approved": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs tools/generate-pirate-pr91-approved-compare.mjs",
    "balance:pirates:pr91:garrison": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs tools/generate-pirate-pr91-garrison-compare.mjs",
    "balance:pirates:pr91:adaptive": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs tools/generate-pirate-pr91-adaptive.mjs",
    "test:repair": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/repair/workshop.test.ts src/application/repair.test.ts",
    "test:operations": "node --experimental-strip-types --test src/domain/operations/operations.test.ts",
    "test:command": "node --experimental-strip-types --test src/domain/command/command.test.ts src/domain/command/aid.test.ts src/domain/command/journal.test.ts src/domain/command/diplomacy.test.ts src/domain/command/crest.test.ts",
    "test:reports": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/reports/reports.test.ts src/domain/profile/profile.test.ts",
    "test:settings": "node --experimental-strip-types --test src/domain/settings/settings.test.ts",
    "test:rating": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/rating/rating.test.ts src/domain/rating/scoring.test.ts",
    "test:runtime": "node --experimental-strip-types --test src/domain/runtime/mode.test.ts",
    "test:resources": "node --experimental-strip-types --test src/domain/resources/credit.test.ts",
    "test:energy": "node --experimental-strip-types --test src/domain/energy/runtime.test.ts",
    "test:fleet": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/fleet/runtime.test.ts src/domain/fleet/production.test.ts src/domain/fleet/overpopulation.test.ts",
    "test:science": "node --experimental-strip-types --test src/domain/science/science.test.ts",
    "test:universe": "node --experimental-strip-types --test src/domain/universe/universe.test.ts src/domain/universe/asteroid-gas.test.ts src/domain/universe/asteroid-simulation.test.ts src/assets/asterion-asset-integration.test.ts",
    "test:science-ui": "electron electron/visual-science.cjs",
    "test:energy-ui": "electron electron/energy-qa.cjs",
    "test:header-ui": "electron electron/header-qa.cjs",
    "test:resource-assets-ui": "electron electron/resource-assets-qa.cjs",
    "test:repair-ui": "electron electron/repair-workshop-qa.cjs",
    "test:spaceport-ui": "electron electron/integration-spaceport-upgrades.cjs",
    "test:fleet-ui": "electron electron/fleet-production-qa.cjs",
    "test:space-flight-ui": "electron electron/space-flight-qa.cjs",
    "test:test-mode-ui": "electron electron/test-mode-qa.cjs",
    "test:production-test-isolation-ui": "electron electron/production-test-isolation-qa.cjs",
    "test:command-ui": "electron electron/command-qa.cjs",
    "test:command-aid-ui": "electron electron/command-aid-qa.cjs",
    "test:command-journal-ui": "electron electron/command-journal-qa.cjs",
    "test:reports-ui": "electron electron/reports-profile-qa.cjs",
    "test:simulator-ui": "electron electron/simulator-qa.cjs",
    "test:battle-reports-ui": "electron electron/battle-report-qa.cjs",
    "test:universe-ui": "electron electron/universe-planet-qa.cjs",
    "test:pirate-operations-ui": "electron electron/pirate-operations-qa.cjs",
    "capture:operations-variant-a": "electron electron/operations-variant-a-screenshots.cjs",
    "test:building-actions-ui": "electron electron/visual-building-actions.cjs",
    "qa:visual": "electron electron/visual-capture.cjs && electron electron/visual-industry-requirements.cjs && electron electron/visual-building-interiors.cjs && electron electron/visual-production-bots.cjs && electron electron/visual-recycling-center.cjs && electron electron/visual-trade-center.cjs && npm run test:spaceport-ui && electron electron/visual-spaceport-upgrades.cjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "test:exploration": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/exploration/exploration.test.ts src/application/exploration.integration.test.ts",
    "balance:exploration:pr92": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs tools/generate-exploration-pr92-balance.mjs",
    "test:sun-raid": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/sun-raid/sun-raid.test.ts src/application/sun-raid.integration.test.ts",
    "test:new-game": "node --experimental-strip-types --experimental-loader ./src/domain/combat/test-asset-loader.mjs --test src/domain/world/world.test.ts src/domain/session/slots.test.ts src/application/new-game.test.ts src/application/save-safety.test.ts",
    "test:new-game-ui": "electron electron/new-game-sun-raid-qa.cjs",
    "test:npc-replay-ui": "electron electron/npc-replay-qa.cjs",
    "test:npc-replay-full-world-ui": "electron electron/npc-replay-qa.cjs --full-world",
    "test:save-safety-ui": "electron electron/save-safety-qa.cjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "sharp": "^0.35.4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.asterion.game",
    "productName": "Asterion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
